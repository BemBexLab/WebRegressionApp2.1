# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webregression
POSTGRES_PASSWORD=postgres
POSTGRES_DB=webregression

# ── Storage API ───────────────────────────────────────────────────────────────
SUPABASE_STORAGE_URL=http://localhost:5000
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=screenshots

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me-in-production

# ── Email (SMTP via Nodemailer) ───────────────────────────────────────────────
# Gmail example:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
# Use an app password, not your account password, for Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=replace-with-app-password
FROM_EMAIL=noreply@example.com
NOTIFICATION_EMAIL=alerts@example.com

# ── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost,http://203.161.44.35:3001,http://203.161.44.35,https://203.161.44.35
NEXT_PUBLIC_API_URL=http://203.161.44.35:4000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── Worker ────────────────────────────────────────────────────────────────────
SCAN_CONCURRENCY=10
MAX_PAGES_PER_SITE=80
DIFF_THRESHOLD=0.01
AUTO_SCAN_INTERVAL_MINUTES=20

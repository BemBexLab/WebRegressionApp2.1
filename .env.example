# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
DATABASE_URL=postgresql://postgres:change-me-strong-db-password@localhost:5432/webregression?schema=public
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=webregression

# ── Storage API ───────────────────────────────────────────────────────────────
SUPABASE_STORAGE_URL=http://localhost:5000
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=screenshots

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-redis-password

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me-in-production

# ── Email (SMTP via Nodemailer) ───────────────────────────────────────────────
# Zoho Cliq incoming webhook URL for the channel that should receive alerts.
CLIQ_WEBHOOK_URL=https://cliq.zoho.com/api/v2/channelsbyname/your-channel/message?zapikey=replace-me
# Optional explicit public origin used in Cliq report links.
PUBLIC_APP_URL=http://203.161.44.35

# ── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost,http://203.161.44.35:3001,http://203.161.44.35,https://203.161.44.35
NEXT_PUBLIC_API_URL=http://203.161.44.35:4000
LOGIN_USER=admin
LOGIN_PASSWORD=change-me-login-password
AUTH_SESSION_SECRET=change-me-session-secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── Worker ────────────────────────────────────────────────────────────────────
SCAN_CONCURRENCY=10
MAX_PAGES_PER_SITE=80
DIFF_THRESHOLD=0.3
AUTO_SCAN_INTERVAL_MINUTES=20
